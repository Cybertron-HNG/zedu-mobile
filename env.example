# Copy this file to .env and fill in the values (.env is ignored by git; this example is named env.example because the repo blocks committing files that start with .env).
# These values are compiled into the app, so never put a secret in them.
# Ask a teammate for the real development values.

# Base URL of the Zedu API, without a trailing slash. Used by src/utils/requests.ts
# and the real-time token requests in src/centrifugoo.
BASE_URL=https://api.example.com/api/v1

# Address of the Zedu web app. Used to build link-preview requests.
CLIENT_URL=https://zedu.chat

# WebSocket address of the real-time (Centrifugo) server.
CONNECT_URL=wss://example.com/connection/websocket

# Web client ID used for Google sign-in (src/lib/google-auth.ts).
GOOGLE_CLIENT_ID=your-google-web-client-id

# OneSignal app ID used for push notifications.
ONESIGNAL_APP_ID=your-onesignal-app-id
